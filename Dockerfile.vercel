FROM node:24-alpine AS web
WORKDIR /app/web
RUN npm install --global pnpm@11.19.0
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

FROM golang:1.27-alpine AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY main.go ./
COPY server/ ./server/
COPY --from=web /app/web/dist ./web/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /nyst .

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /nyst /nyst
ENV PORT=80
USER 65532:65532
EXPOSE 80
CMD ["/nyst"]
